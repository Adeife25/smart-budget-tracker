# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (falls back to FRONTEND_URL).
# In production this should be your frontend's public URL(s), e.g.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=

# Auth
# Required in production; startup fails if missing or left as a placeholder.
JWT_SECRET=
# Access-token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=2592000
JWT_VERIFY_SECRET=

# OAuth (Google + GitHub)
# Optional. Set all three values per provider to enable social login.
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Cleanup
# How many days to keep expired tokens before deleting them (default 7)
TOKEN_CLEANUP_RETENTION_DAYS=7

# Email (Resend). Without a key, emails are skipped and links are logged to
# the console instead (dev convenience only).
RESEND_API_KEY=
EMAIL_FROM="Smart Budget Tracker <onboarding@resend.dev>"

# Redis (caching + queues)
# The host/port the app uses to reach Redis. In docker-compose the app is
# pointed at the `redis` service via REDIS_HOST=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# How long cached responses are kept before being re-fetched (default 300s)
CACHE_TTL_SECONDS=300
